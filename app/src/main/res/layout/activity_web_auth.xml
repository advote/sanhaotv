<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_000000_60"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_60"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_24"
        android:paddingRight="@dimen/vs_24">

        <ImageView
            android:id="@+id/btnAuthBack"
            android:layout_width="@dimen/vs_35"
            android:layout_height="@dimen/vs_35"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/icon_back"
            android:contentDescription="返回" />

        <TextView
            android:id="@+id/tvAuthTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/vs_15"
            android:text="网盘授权"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_28" />
    </LinearLayout>

    <WebView
        android:id="@+id/webAuthView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
